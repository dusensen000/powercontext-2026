# StepFun（比赛提供）
STEP_API_KEY=
STEP_BASE_URL=https://api.stepfun.com/v1
STEP_MODEL=step-3.5-flash

# 本地 embedding（StepFun 无 embedding 接口，用 bge 中文模型）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
HF_ENDPOINT=https://hf-mirror.com

# seekdb：默认嵌入式，数据目录放 WSL 侧（是目录不是文件），避免 /mnt/c 的文件锁问题
SEEKDB_PATH=/home/dss/relay-data/seekdb.db
SEEKDB_DATABASE=relay
SEEKDB_COLLECTION=work_items
# 填了 SEEKDB_HOST 就切到 server 模式（seekdb Server / OceanBase）
SEEKDB_HOST=
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=

# 去重阈值：余弦距离，越小越相似。实测同件事 0.09–0.28，不同任务 >0.34
DEDUPE_THRESHOLD=0.28

# PowerContext：留空 SCOPE_ID 时，脚本会回落到 data/out/powercontext-scope.json
POWERCONTEXT_BASE_URL=http://127.0.0.1:8000
POWERCONTEXT_SCOPE_ID=
POWERCONTEXT_TOKEN=
