# Copy to backend/.env (or export) and adjust for your host.
# Never commit real credentials.

# seekdb is the required backend for the submitted verification.
TAVERN_DB_BACKEND=seekdb
TAVERN_DB_NAME=tavern
# Put this on an ext4 path inside Linux/WSL, not on /mnt/c.
TAVERN_DATA_DIR=/opt/tavern/data
TAVERN_DB_PATH=/opt/tavern/data/tavern.db

TAVERN_HOST=0.0.0.0
TAVERN_PORT=8770

POWERCONTEXT_URL=http://127.0.0.1:8000
POWERCONTEXT_TOKEN=

# Optional: where selftest.py writes JSON evidence and the backend writes logs.
TAVERN_LOG_DIR=/opt/tavern/evidence/logs
TAVERN_EVIDENCE_DIR=/opt/tavern/evidence
