2026-10-31T12:23:07	backend=seekdb	db=tavern	rows=0	params=[1, 'drink', '火焰威士忌', '入口像被龙舔了一口，回味是蜂蜜。杯口会自己冒火星，喝之前老巴会先收走你的眉毛。', '火焰,威士忌,烈酒,龙', 8]	sql=INSERT INTO lore (id, category, title, content, keywords, price) VALUES (%s,%s,%s,%s,%s,%s)
2026-10-31T12:23:07	backend=seekdb	db=tavern	rows=0	params=[2, 'drink', '月光艾尔', '杯口浮着一层银色泡沫，喝下去会想起初恋。独眼莉娜说这酒兑了她三个故事。', '月光,艾尔,啤酒,初恋', 5]	sql=INSERT INTO lore (id, category, title, content, keywords, price) VALUES (%s,%s,%s,%s,%s,%s)
2026-10-31T12:23:07	backend=seekdb	db=tavern	rows=0	params=[3, 'drink', '龙王陈酿', '酒窖最深处只存三桶。老巴从不主动拿出来，除非你先把旧账结清。', '龙王,陈酿,珍藏,贵的酒', 30]	sql=INSERT INTO lore (id, category, title, content, keywords, price) VALUES (%s,%s,%s,%s,%s,%s)
2026-10-31T12:23:07	backend=seekdb	db=tavern	rows=0	params=[4, 'drink', '忘忧茶', '喝了会忘记十分钟内发生的事。老巴用它赖掉自己的口误，也用它送走不想再见的客人。', '忘忧,茶,忘记', 3]	sql=INSERT INTO lore (id, category, title, content, keywords, price) VALUES (%s,%s,%s,%s,%s,%s)
2026-10-31T12:23:07	backend=seekdb	db=tavern	rows=0	params=[5, 'drink', '爆炸蘑菇汤', '端上来时还在冒泡，喝之前要签免责声明。上周有个矮人签了，现在他的胡子长在眉毛上。', '蘑菇,汤,爆炸,免责', 6]	sql=INSERT INTO lore (id, category, title, content, keywords, price) VALUES (%s,%s,%s,%s,%s,%s)
2026-10-31T12:23:07	backend=seekdb	db=tavern	rows=0	params=[6, 'drink', '铁锈钉子酒', '矿工的最爱，杯子里真的泡着一根钉子。老巴说钉子不是用来喝的，是用来提醒你别赊账。', '钉子,矿工,便宜', 2]	sql=INSERT INTO lore (id, category, title, content, keywords, price) VALUES (%s,%s,%s,%s,%s,%s)
2026-10-31T12:23:07	backend=seekdb	db=tavern	rows=0	params=[7, 'rumor', '地下室有龙', '有人说地窖尽头传来鼾声，老巴坚持那是锅炉。可锅炉为什么每周要吃掉一桶月光艾尔？', '地下室,地窖,龙,鼾声', 0]	sql=INSERT INTO lore (id, category, title, content, keywords, price) VALUES (%s,%s,%s,%s,%s,%s)
2026-10-31T12:23:07	backend=seekdb	db=tavern	rows=0	params=[8, 'rumor', '老巴的假眼', '他的左眼从不眨。镇上的人说，那只眼睛能看穿谎言，也能记住每一个赖账的夜晚。', '假眼,左眼,谎言', 0]	sql=INSERT INTO lore (id, category, title, content, keywords, price) VALUES (%s,%s,%s,%s,%s,%s)
2026-10-31T12:23:07	backend=seekdb	db=tavern	rows=0	params=[9, 'rumor', '镇长欠账', '镇长三年前赊了一整桶月光艾尔，至今没还。老巴把那张欠条裱起来，挂在收债人铁算盘够得着的地方。', '镇长,欠账,艾尔', 0]	sql=INSERT INTO lore (id, category, title, content, keywords, price) VALUES (%s,%s,%s,%s,%s,%s)
2026-10-31T12:23:07	backend=seekdb	db=tavern	rows=0	params=[10, 'rumor', '后门的客人', '凌晨三点，总有穿黑袍的人从后门进来，只点一杯忘忧茶，喝完就走，从不说话。', '后门,黑袍,凌晨', 0]	sql=INSERT INTO lore (id, category, title, content, keywords, price) VALUES (%s,%s,%s,%s,%s,%s)
2026-10-31T12:23:07	backend=seekdb	db=tavern	rows=0	params=[11, 'rumor', '酒杯编号', '每个常客都有专属酒杯，杯底刻着他们第一次欠账的日期。老巴说那是最诚实的族谱。', '酒杯,编号,常客,杯底', 0]	sql=INSERT INTO lore (id, category, title, content, keywords, price) VALUES (%s,%s,%s,%s,%s,%s)
2026-10-31T12:23:07	backend=seekdb	db=tavern	rows=0	params=[12, 'rumor', '会说话的猫', '酒馆的猫叫阿账，会重复客人说过的最后一句话。所以没人敢在它面前承认自己赖账。', '猫,阿账,说话', 0]	sql=INSERT INTO lore (id, category, title, content, keywords, price) VALUES (%s,%s,%s,%s,%s,%s)
2026-10-31T12:23:07	backend=seekdb	db=tavern	rows=0	params=[13, 'rumor', '吟游诗人的谎', '小调唱的歌一半是真的，另一半是他自己编的。老巴说：编得好的那半，也算还了酒钱。', '吟游诗人,小调,歌', 0]	sql=INSERT INTO lore (id, category, title, content, keywords, price) VALUES (%s,%s,%s,%s,%s,%s)
2026-10-31T12:23:07	backend=seekdb	db=tavern	rows=0	params=[14, 'regular', '独眼莉娜', '赏金猎人。喝月光艾尔从不付现，只讲一个故事抵账。老巴每次都说不值，但每次都给她续杯。', '莉娜,赏金猎人,独眼', 0]	sql=INSERT INTO lore (id, category, title, content, keywords, price) VALUES (%s,%s,%s,%s,%s,%s)
2026-10-31T12:23:07	backend=seekdb	db=tavern	rows=0	params=[15, 'regular', '铁算盘', '收债人，每周四来核对老巴的账本，最讨厌赖账。他打算盘的声音像在给谁数剩下的日子。', '铁算盘,收债,账本,周四', 0]	sql=INSERT INTO lore (id, category, title, content, keywords, price) VALUES (%s,%s,%s,%s,%s,%s)
2026-10-31T12:23:07	backend=seekdb	db=tavern	rows=0	params=[16, 'regular', '小调', '吟游诗人，欠了老巴十七杯酒和一首没写完的歌。他坚称歌写完就能抵债，老巴坚称他永远写不完。', '小调,吟游诗人,欠', 0]	sql=INSERT INTO lore (id, category, title, content, keywords, price) VALUES (%s,%s,%s,%s,%s,%s)
2026-10-31T12:23:07	backend=seekdb	db=tavern	rows=0	params=[17, 'regular', '老巴', '记忆酒馆的老板。左眼是假的，右眼很毒。他记得每个赖账的人，也记得每一句道歉。', '老巴,老板,酒保', 0]	sql=INSERT INTO lore (id, category, title, content, keywords, price) VALUES (%s,%s,%s,%s,%s,%s)
2026-10-31T12:23:07	backend=seekdb	db=tavern	rows=0	params=[18, 'rule', '赊账规则', '赊账要在杯垫上签名，利息是每天一个离谱的故事。故事不好笑，利息翻倍。', '赊账,规则,签名,利息', 0]	sql=INSERT INTO lore (id, category, title, content, keywords, price) VALUES (%s,%s,%s,%s,%s,%s)
2026-10-31T12:23:07	backend=seekdb	db=tavern	rows=0	params=[19, 'rule', '撒谎惩罚', '被老巴识破一次撒谎，罚一杯铁锈钉子酒，并在账本上记仇一格。赖账可以商量，撒谎不行。', '撒谎,惩罚,罚酒', 0]	sql=INSERT INTO lore (id, category, title, content, keywords, price) VALUES (%s,%s,%s,%s,%s,%s)
2026-10-31T12:23:07	backend=seekdb	db=tavern	rows=0	params=[20, 'rule', '偷窃惩罚', '顺走酒杯的人要赔双倍，还会被猫阿账记一辈子。阿账的记忆力比老巴的假眼还可怕。', '偷,顺走,赔,猫', 0]	sql=INSERT INTO lore (id, category, title, content, keywords, price) VALUES (%s,%s,%s,%s,%s,%s)
2026-10-31T12:23:07	backend=seekdb	db=tavern	rows=0	params=[21, 'rule', '打烊规矩', '凌晨四点打烊。赖着不走的人，会被老巴用假眼盯着，直到自己觉得不好意思。', '打烊,凌晨,规矩', 0]	sql=INSERT INTO lore (id, category, title, content, keywords, price) VALUES (%s,%s,%s,%s,%s,%s)
2026-10-31T12:23:07	backend=seekdb	db=tavern	rows=0	params=[22, 'rule', '还账方式', '现金、故事，或者帮老巴擦一晚上杯子，三选一。老巴通常建议选第三个，因为前两个他见得太多了。', '还账,现金,故事,擦杯子', 0]	sql=INSERT INTO lore (id, category, title, content, keywords, price) VALUES (%s,%s,%s,%s,%s,%s)
2026-10-31T12:23:07	backend=seekdb	db=tavern	rows=0	params=[23, 'secret', '老巴的女儿', '吧台后面挂着一幅旧画像，画里的姑娘和老巴有一样的左眼。没人敢问，老巴也从不主动说。', '画像,女儿,姑娘', 0]	sql=INSERT INTO lore (id, category, title, content, keywords, price) VALUES (%s,%s,%s,%s,%s,%s)
