# Copy to .env and fill in real values. Never commit real credentials.

# --- MiniMax ---------------------------------------------------------------
MINIMAX_API_KEY=replace-with-your-key
MINIMAX_MODEL=MiniMax-M3
MINIMAX_BASE_URL=https://api.minimaxi.com
MINIMAX_PROTOCOL=minimax
# Reasoning output counts against max_tokens; keep this generous.
MINIMAX_MAX_TOKENS=8192
MINIMAX_TIMEOUT=180

# --- seekdb ----------------------------------------------------------------
SDDCTX_DB_BACKEND=seekdb
SDDCTX_DB_PATH=./.data/seekdb
SDDCTX_DB_NAME=sddctx

# --- PowerContext ----------------------------------------------------------
POWERCONTEXT_URL=http://127.0.0.1:8000
POWERCONTEXT_STATE_BACKEND=powercontext
# POWERCONTEXT_SCOPE=
# POWERCONTEXT_TOKEN=
