2026-10-31T11:57:58	backend=seekdb	db=sddctx_evolve	rows=0	params=['src/taskboard/service.py', 'code', None, '<module>', 1, 'from typing import Iterable, List, Optional\n\nfrom .models import Task\n\n\ndef list_tasks(\n    tasks: Iterable[Task],\n    limit: int = 10,\n    offset: int = 0,\n    status: Optional[str] = None,\n) -> List[Task]:\n    """Return a sorted, paginated page of tasks.\n\n    REQ-001: sort by (due_date, id) ascending.\n    REQ-002: sort first, then paginate with limit/offset.\n    REQ-003: filter by status before sorting/pagination (not implemented yet).\n    REQ-004: validate limit/offset and raise ValueError on invalid input.\n    """\n    if limit <= 0:\n        raise ValueError("limit must be a positive integer")\n    if offset < 0:\n        raise ValueError("offset must be >= 0")\n\n    ordered = sorted(tasks, key=lambda task: (task.due_date, task.id))\n\n    # TODO(REQ-003): apply the status filter here, before pagination.\n\n    return ordered[offset : offset + limit]\n', '1e172d71757a5b51097187e71bbdd741a94711f9']	sql=INSERT INTO eng_docs (path, kind, req_id, symbol, lineno, text, hash) VALUES (%s,%s,%s,%s,%s,%s,%s)
2026-10-31T11:57:58	backend=seekdb	db=sddctx_evolve	rows=0	params=['src/taskboard/service.py', 'code', None, 'list_tasks', 6, 'def list_tasks(\n    tasks: Iterable[Task],\n    limit: int = 10,\n    offset: int = 0,\n    status: Optional[str] = None,\n) -> List[Task]:\n    """Return a sorted, paginated page of tasks.\n\n    REQ-001: sort by (due_date, id) ascending.\n    REQ-002: sort first, then paginate with limit/offset.\n    REQ-003: filter by status before sorting/pagination (not implemented yet).\n    REQ-004: validate limit/offset and raise ValueError on invalid input.\n    """\n    if limit <= 0:\n        raise ValueError("limit must be a positive integer")\n    if offset < 0:\n        raise ValueError("offset must be >= 0")\n\n    ordered = sorted(tasks, key=lambda task: (task.due_date, task.id))\n\n    # TODO(REQ-003): apply the status filter here, before pagination.\n\n    return ordered[offset : offset + limit]', 'ccca98942930d1f2811b0ad230007be765559420']	sql=INSERT INTO eng_docs (path, kind, req_id, symbol, lineno, text, hash) VALUES (%s,%s,%s,%s,%s,%s,%s)
2026-10-31T11:57:58	backend=seekdb	db=sddctx_evolve	rows=0	params=['tests/test_regression.py', 'test', None, '<module>', 1, '"""Regression tests: these must pass both before and after the target change."""\n\nimport pytest\n\nfrom taskboard.models import Task\nfrom taskboard.service import list_tasks\n\n\ndef make_tasks():\n    return [\n        Task(id=1, title="Write report", status="active", due_date="2026-05-01"),\n        Task(id=2, title="Review PR", status="done", due_date="2026-05-02"),\n        Task(id=3, title="Fix bug", status="active", due_date="2026-05-02"),\n        Task(id=4, title="Plan sprint", status="done", due_date="2026-05-03"),\n        Task(id=5, title="Deploy", status="active", due_date="2026-05-04"),\n    ]\n\n\ndef test_sorts_by_due_date_then_id():\n    result = list_tasks(make_tasks())\n    assert [t.id for t in result] == [1, 2, 3, 4, 5]\n\n\ndef test_pagination_after_sorting():\n    result = list_tasks(make_tasks(), limit=2, offset=1)\n    assert [t.id for t in result] == [2, 3]\n\n\ndef test_no_status_returns_all():\n    result = list_tasks(make_tasks(), limit=10, offset=0, status=None)\n    assert len(result) == 5\n\n\ndef test_invalid_limit_raises():\n    with pytest.raises(ValueError):\n        list_tasks(make_tasks(), limit=0)\n\n\ndef test_invalid_offset_raises():\n    with pytest.raises(ValueError):\n        list_tasks(make_tasks(), offset=-1)\n', 'bde77b0b890c805ccdad73b1cb4e6b80cbbba608']	sql=INSERT INTO eng_docs (path, kind, req_id, symbol, lineno, text, hash) VALUES (%s,%s,%s,%s,%s,%s,%s)
